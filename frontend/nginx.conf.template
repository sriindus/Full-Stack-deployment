server {
    # Non-privileged port so the container can run as a non-root user both
    # in docker-compose and under a Kubernetes PodSecurityContext.
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Single-page app: let React Router (if added later) handle deep links.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Same-origin reverse proxy to the backend service so the browser never
    # needs to know the backend's hostname, and CORS is a non-issue in the
    # docker-compose deployment. ${BACKEND_UPSTREAM} is substituted at image
    # build time (see the frontend Dockerfile's BACKEND_UPSTREAM build arg).
    # In Kubernetes the Ingress routes /api straight to the backend Service
    # instead, so this proxy is a fallback for direct-to-frontend requests.
    location /api/ {
        proxy_pass http://${BACKEND_UPSTREAM}/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location = /healthz {
        return 200 "ok\n";
        add_header Content-Type text/plain;
    }
}
